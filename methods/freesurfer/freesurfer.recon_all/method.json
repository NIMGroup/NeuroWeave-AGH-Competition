  "input_slots": [
    {
      "id": "t1w",
      "type": "t1w_image",
      "label": "T1w 输入",
      "description": "autorecon1 或 all 的原始全头 T1w；脑提取后的 T1w 可能影响颅骨剥离和表面重建。",
      "required": false,
      "required_when": {
        "processing_stage": [
          "autorecon1",
          "all"
        ]
      },
      "cardinality": "one",
      "binding": "file",
      "formats": [
        ".nii",
        ".nii.gz",
        ".mgz"
      ],
      "companions": [],
      "source_options": [
        "dataset",
        "existing_path",
        "upstream_output"
      ],
      "validation": [
        "path_exists"
      ]
    },
    {
      "id": "subject",
      "type": "freesurfer_subject",
      "label": "已有 FreeSurfer 受试者目录",
      "description": "Existing subject directory for autorecon2, autorecon3 or stats, with the prerequisite stages completed. Resume within the same SUBJECTS_DIR; this is not a raw T1w file.",
      "required": false,
      "required_when": {
        "processing_stage": [
          "autorecon2",
          "autorecon3",
          "stats"
        ]
      },
      "cardinality": "one",
      "binding": "folder",
      "formats": [],
      "companions": [],
      "source_options": [
        "existing_path",
        "upstream_output"
      ],
      "validation": [
        "path_exists"
      ]
    },
    {
      "id": "t2w",
      "type": "imaging_input",
      "label": "可选 T2w",
      "description": "启用 T2 pial refinement 时提供。",
      "required": false,
      "required_when": {
        "use_t2": [
          true
        ]
      },
      "cardinality": "one",
      "binding": "file",
      "formats": [
        ".nii",
        ".nii.gz",
        ".mgz"
      ],
      "companions": [],
      "source_options": [
        "dataset",
        "existing_path"
      ],
      "validation": [
        "path_exists"
      ]
    },
    {
      "id": "flair",
      "type": "imaging_input",
      "label": "可选 FLAIR",
      "description": "启用 FLAIR pial refinement 时提供。",
      "required": false,
      "required_when": {
        "use_flair": [
          true
        ]
      },
      "cardinality": "one",
      "binding": "file",
      "formats": [
        ".nii",
        ".nii.gz",
        ".mgz"
      ],
      "companions": [],
      "source_options": [
        "dataset",
        "existing_path"
      ],
      "validation": [
        "path_exists"
      ]
    }
  ],
  "output_slots": [
    {
      "id": "subject",
      "type": "freesurfer_subject",
      "label": "FreeSurfer 受试者目录",
      "description": "FreeSurfer subject directory containing mri, surf, label and stats. Its existence alone does not certify completion of later stages; use the stage-specific file ports for downstream binding.",
      "format": "",
      "primary": true,
      "path_template": "{subject}/",
      "generated_when": {}
    },
    {
      "id": "t1w",
      "type": "t1w_image",
      "label": "T1 volume",
      "description": "Conformed T1 volume in the FreeSurfer subject grid. This grid may differ from the original acquisition and from DWI.",
      "format": ".mgz",
      "primary": false,
      "path_template": "{subject}/mri/T1.mgz",
      "generated_when": {
        "processing_stage": [
          "all",
          "autorecon1"
        ]
      }
    },
    {
      "id": "brain_t1w",
      "type": "t1w_image",
      "label": "Brain-extracted T1",
      "description": "Skull-stripped T1 intensities, despite the filename brainmask.mgz. This is not a binary brain mask.",
      "format": ".mgz",
      "primary": false,
      "path_template": "{subject}/mri/brainmask.mgz",
      "generated_when": {
        "processing_stage": [
          "all",
          "autorecon1"
        ]
      }
    },
    {
      "id": "parcellation",
      "type": "parcellation_image",
      "label": "Anatomical cortical and subcortical parcellation",
      "description": "Integer Desikan-Killiany cortical and aseg subcortical labels in subject structural space. FreeSurferColorLUT defines label meaning; labels are not contiguous connectome indices. Confirm alignment to streamlines, and remap with the appropriate LUT if needed. Do not use linear interpolation for labels.",
      "format": ".mgz",
      "primary": false,
      "path_template": "{subject}/mri/aparc+aseg.mgz",
      "generated_when": {
        "processing_stage": [
          "all",
          "autorecon3"
        ]
      }
    },
    {
      "id": "aseg",
      "type": "label_image",
      "label": "Subcortical segmentation",
      "description": "FreeSurfer anatomical segmentation labels in subject space. This alone does not provide the cortical atlas regions contained in aparc+aseg.mgz.",
      "format": ".mgz",
      "primary": false,
      "path_template": "{subject}/mri/aseg.mgz",
      "generated_when": {
        "processing_stage": [
          "all",
          "autorecon3"
        ]
      }
    },
    {
      "id": "aseg_stats",
      "type": "generated_file",
      "label": "Segmentation statistics",
      "description": "Region statistics table with label IDs, voxel counts and volumes. It is a text report, not a spatial node image. This generic file port does not establish a specialized scientific artifact type; downstream use must match the documented contents, not merely the filename extension.",
      "format": ".stats",
      "primary": false,
      "path_template": "{subject}/stats/aseg.stats",
      "generated_when": {
        "processing_stage": [
          "all",
          "autorecon3",
          "stats"
        ]
      }
    }
  ],
