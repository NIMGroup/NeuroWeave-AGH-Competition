{
  "label": "FreeSurfer recon-all（可执行）",
  "description": "Run FreeSurfer recon-all for T1w cortical surface reconstruction, subcortical segmentation and anatomical atlas parcellation. all runs the full reconstruction; autorecon1/2/3 are consecutive stages, and stats recomputes statistics in an existing subject directory. all/autorecon3 expose mri/aparc+aseg.mgz as a Desikan-Killiany cortical plus subcortical node image, not just a result folder. Labels are in the subject structural space, not automatically aligned to DWI or streamlines. Connectome use requires checking alignment and the atlas lookup table; labelconvert remaps IDs but does not register images. Tissue segmentation, 5TT and data-driven clusters are different products.",
  "runner_id": "freesurfer.recon_all",
  "input_types": [
    "t1w_image",
    "freesurfer_subject",
    "imaging_input"
  ],
  "output_types": [
    "freesurfer_subject",
    "t1w_image",
    "parcellation_image",
    "label_image",
    "generated_file"
  ],
  "requires_features": [
    "has_t1w"
  ],
  "parameters": [
    {
      "id": "processing_stage",
      "argument": "stage",
      "label": "处理范围",
      "description": "all/autorecon1 从 T1w 开始；autorecon2、autorecon3 和 stats 必须从已有受试者目录续跑。",
      "type": "string",
      "control": "select",
      "level": "basic",
      "group": "处理范围",
      "unit": "",
      "required": true,
      "default": "all",
      "options": [
        {
          "value": "autorecon1",
          "label": "autorecon1：体数据准备",
          "description": ""
        },
        {
          "value": "autorecon2",
          "label": "autorecon2：白质与表面",
          "description": ""
        },
        {
          "value": "autorecon3",
          "label": "autorecon3：配准、分区与统计",
          "description": ""
        },
        {
          "value": "stats",
          "label": "仅重建统计",
          "description": ""
        },
        {
          "value": "all",
