      "description": "display debugging messages.",
      "type": "boolean",
      "required": false,
      "default": false
    },
    {
      "id": "nthreads",
      "argument": "nthreads",
      "label": "nthreads",
      "description": "use this number of threads in multi-threaded applications (set to 0 to disable multi-threading).",
      "type": "integer",
      "required": true,
      "default": 1,
      "usage": "使用原始命令参数；未指定的可选参数不传给软件。",
      "software_default": "参见本机安装版本原始帮助。",
