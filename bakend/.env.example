# Copy this file to .env. Never commit the real API key.
# Leave base URL and model empty for safe demo mode. Example DeepSeek values:
# LOCALFLOW_LLM_BASE_URL=https://api.deepseek.com
# LOCALFLOW_LLM_MODEL=deepseek-chat
LOCALFLOW_LLM_BASE_URL=
LOCALFLOW_LLM_API_KEY=
LOCALFLOW_LLM_MODEL=
LOCALFLOW_LLM_MAX_TOKENS=800
LOCALFLOW_LLM_THINKING=enabled
# Legacy minimum total budget when Thinking is enabled, NOT a separate reasoning cap.
LOCALFLOW_LLM_THINKING_MAX_TOKENS=8192
# Initial total generation budget for assistant calls (reasoning + text/arguments).
LOCALFLOW_ASSISTANT_MAX_TOKENS=16384
# Bounded ceiling for adaptive retries; verify this limit with your model service.
LOCALFLOW_LLM_MAX_GENERATION_TOKENS=32768
# Tool observations are summaries with scoped evidence references; full data remains in storage.
LOCALFLOW_ASSISTANT_TOOL_RESULT_CHARS=6000
LOCALFLOW_ASSISTANT_CONTEXT_CHARS=48000
# Generation recovery remains bounded by per-request and per-turn timeouts.
LOCALFLOW_LLM_REQUEST_TIMEOUT_SECONDS=180
LOCALFLOW_ASSISTANT_TURN_TIMEOUT_SECONDS=600
LOCALFLOW_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Semicolon-separated folders that the web UI is allowed to browse.
# Example: D:\datasets;E:\research-data
# An optional label can be declared as: 服务器根目录::/server
LOCALFLOW_DATA_ROOTS=
# Hidden directory components such as .ssh are rejected unless explicitly enabled.
LOCALFLOW_ALLOW_HIDDEN_PATHS=false
LOCALFLOW_DATABASE_PATH=data/localflow.db
# Durable artifacts from trusted Runner executions.
LOCALFLOW_OUTPUT_ROOT=../outputs
# Number of background workflow workers (1-16).
LOCALFLOW_RUN_WORKERS=2
# Semicolon-separated roots from which trusted runners may read bound inputs.
LOCALFLOW_RUN_INPUT_ROOTS=/server
# Existing software locations (no environment creation is performed by NeuroWeave).
LOCALFLOW_FSL_ROOT=/opt/software/fsl
LOCALFLOW_MRTRIX_ROOT=/opt/software/mrtrix3-master
LOCALFLOW_MRTRIX_LIBPNG=/lib/x86_64-linux-gnu/libpng16.so.16
LOCALFLOW_FREESURFER_HOME=/opt/software/freesurfer-7.4.1/usr/local/freesurfer/7.4.1
LOCALFLOW_FREESURFER_LICENSE=/opt/software/freesurfer-7.4.1/usr/local/freesurfer/7.4.1/license.txt
# Compact older messages after this estimated input-token budget is reached.
LOCALFLOW_HISTORY_COMPACT_TRIGGER_TOKENS=12000
# Keep this many recent raw messages after each compaction.
LOCALFLOW_HISTORY_KEEP_RECENT_MESSAGES=8
# Optional operator login / data ACLs. Default preserves legacy local access but
# disables in-place edits. See deploy/data-assistant.md; never commit real hashes.
NEUROWEAVE_DATA_USERS={}
NEUROWEAVE_SESSION_SECURE=false
# An existing, administrator-built Docker image; empty disables generated Python.
NEUROWEAVE_DATA_PYTHON_IMAGE=
NEUROWEAVE_DOCKER=docker
