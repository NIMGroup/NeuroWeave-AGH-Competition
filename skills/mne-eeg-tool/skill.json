{
  "schema_version": 1,
  "id": "mne-eeg-tool",
  "description": "mne-eeg-tool 统筹已登记的独立方法和可复用流程。支持：EEG/MEG 数据检查；MNE LOF 坏导联检测与插值；EEG/MEG 滤波与降采样；MNE ICA 分解与指定成分去除；重参考与分段；Epoch AutoReject 自动质控；传感器 PLV/相干/wPLI；Morlet 时频功率与 ITC；其他方法可在详情中分页查询。",
  "method_refs": [
    {
      "capability": "skill.mne-eeg-tool",
      "method_id": "reviewed-inspect-mne-eeg-tool",
      "label": "EEG/MEG 数据检查",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [
        "loadeeg",
        "load-validation",
        "load-basic-validation"
      ],
      "execution_resolution": {},
      "role": "Read a supported continuous EEG/MEG recording, reject non-finite data, report channel/sample counts and sampling frequency, and save the recording as FIF。 Inputs: input: EEG/MEG 原始文件（FIF/EDF/BDF/SET） (file). Registered outputs: results/processed-raw.fif. Fixed invocation options: --operation inspect.",
      "method_ref": "reviewed.mne-eeg-tool.inspect"
    },
    {
      "capability": "skill.mne-eeg-tool",
      "method_id": "reviewed-bad-channels-mne-eeg-tool",
      "label": "MNE LOF 坏导联检测与插值",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [],
      "execution_resolution": {},
      "role": "Detect EEG bad channels using MNE local-outlier-factor detection and interpolate them using channel positions; retain the detected-channel list in the summary。 Inputs: input: EEG/MEG 原始文件（FIF/EDF/BDF/SET） (file). Registered outputs: results/processed-raw.fif. Fixed invocation options: --operation bad-channels.",
      "method_ref": "reviewed.mne-eeg-tool.bad-channels"
    },
    {
      "capability": "skill.mne-eeg-tool",
      "method_id": "reviewed-filter-mne-eeg-tool",
      "label": "EEG/MEG 滤波与降采样",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [
        "preprocessfiltering",
        "downsampling-filtering",
        "filtering"
      ],
      "execution_resolution": {},
      "role": "Apply MNE IIR band-pass filtering, optional notch filtering and optional downsampling to continuous data; validate cutoffs against the original and requested Nyquist frequencies。 Inputs: input: EEG/MEG 原始文件（FIF/EDF/BDF/SET） (file). Registered outputs: results/processed-raw.fif. Fixed invocation options: --operation filter.",
      "method_ref": "reviewed.mne-eeg-tool.filter"
    },
    {
      "capability": "skill.mne-eeg-tool",
      "method_id": "reviewed-ica-mne-eeg-tool",
      "label": "MNE ICA 分解与指定成分去除",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [],
      "execution_resolution": {},
      "role": "Fit MNE ICA on a high-pass-filtered copy, identify EOG/ECG-related components when corresponding channels exist, combine explicit exclusions and apply the fitted cleaning to the recording。 Inputs: input: EEG/MEG 原始文件（FIF/EDF/BDF/SET） (file). Registered outputs: results/processed-raw.fif. Fixed invocation options: --operation ica.",
      "method_ref": "reviewed.mne-eeg-tool.ica"
    },
    {
      "capability": "skill.mne-eeg-tool",
      "method_id": "reviewed-epoch-mne-eeg-tool",
      "label": "重参考与分段",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [
        "rereferenceandepoch",
        "re-referencing-epoching",
        "epoching"
      ],
      "execution_resolution": {},
      "role": "Create MNE epochs from supplied events and time limits, or fixed-duration epochs when events are absent; apply average EEG referencing and save accepted epochs as FIF。 Inputs: input: EEG/MEG 原始文件（FIF/EDF/BDF/SET） (file); events: MNE 事件文件 (file). Registered outputs: results/processed-epo.fif. Fixed invocation options: --operation epoch.",
      "method_ref": "reviewed.mne-eeg-tool.epoch"
    },
    {
      "capability": "skill.mne-eeg-tool",
      "method_id": "reviewed-autoreject-mne-eeg-tool",
      "label": "Epoch AutoReject 自动质控",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [],
      "execution_resolution": {},
      "role": "Create epochs and run AutoReject with cross-validation to repair/reject contaminated epochs. At least four epochs and valid sensor positions are required。 Inputs: input: EEG/MEG 原始文件（FIF/EDF/BDF/SET） (file); events: MNE 事件文件 (file). Registered outputs: results/processed-epo.fif. Fixed invocation options: --operation autoreject.",
      "method_ref": "reviewed.mne-eeg-tool.autoreject"
    },
    {
      "capability": "skill.mne-eeg-tool",
      "method_id": "reviewed-connectivity-mne-eeg-tool",
      "label": "传感器 PLV/相干/wPLI",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [
        "computeconnectivity",
        "sensor-level-connectivity"
      ],
      "execution_resolution": {},
      "role": "Create epochs and compute spectral PLV, coherence and wPLI in the requested frequency band using mne-connectivity; export matrices and channel names in NPZ。 Inputs: input: EEG/MEG 原始文件（FIF/EDF/BDF/SET） (file); events: MNE 事件文件 (file). Registered outputs: results/connectivity.npz. Fixed invocation options: --operation connectivity.",
      "method_ref": "reviewed.mne-eeg-tool.connectivity"
    },
    {
      "capability": "skill.mne-eeg-tool",
      "method_id": "reviewed-time-frequency-mne-eeg-tool",
      "label": "Morlet 时频功率与 ITC",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [
        "time-frequency-analysis"
      ],
      "execution_resolution": {},
      "role": "Compute averaged Morlet time-frequency power and inter-trial coherence from epochs at twelve frequencies spanning the selected band; export power, ITC, frequencies and times。 Inputs: input: EEG/MEG 原始文件（FIF/EDF/BDF/SET） (file); events: MNE 事件文件 (file). Registered outputs: results/time_frequency.npz. Fixed invocation options: --operation time-frequency.",
      "method_ref": "reviewed.mne-eeg-tool.time-frequency"
    },
    {
      "capability": "skill.mne-eeg-tool",
      "method_id": "reviewed-maxwell-mne-eeg-tool",
      "label": "MEG Maxwell 滤波",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [
        "maxwell-filtering"
      ],
      "execution_resolution": {},
      "role": "Apply MNE Maxwell filtering to continuous MEG using the adapter origin (0, 0, 0.04 m); MEG sensors and a device-to-head transform are required。 Inputs: input: EEG/MEG 原始文件（FIF/EDF/BDF/SET） (file). Registered outputs: results/processed-raw.fif. Fixed invocation options: --operation maxwell.",
      "method_ref": "reviewed.mne-eeg-tool.maxwell"
    },
    {
      "capability": "skill.mne-eeg-tool",
      "method_id": "reviewed-source-mne-eeg-tool",
      "label": "dSPM 源定位（需前向模型和噪声协方差）",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [
        "source-localization"
      ],
      "execution_resolution": {},
      "role": "Construct an MNE inverse operator from the supplied forward solution and noise covariance, then apply dSPM to continuous data with lambda2=1/9; export source amplitudes, times and vertices。 Inputs: input: EEG/MEG 原始文件（FIF/EDF/BDF/SET） (file); forward: 前向模型 FIF (file); noise_cov: 噪声协方差 FIF (file). Registered outputs: results/source.npz. Fixed invocation options: --operation source.",
      "method_ref": "reviewed.mne-eeg-tool.source"
    },
    {
      "capability": "skill.mne-eeg-tool",
      "method_id": "reviewed-original-bands-mne-eeg-tool",
      "label": "原脚本 Welch 频带功率与分频文件",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [],
      "execution_resolution": {},
      "role": "Use the original function to filter delta, theta, alpha, beta and gamma bands, compute channel-wise mean Welch spectral power and export band-specific FIF recordings plus band_power.csv. Inputs: input: 原始 EEG 文件 (file). Registered outputs: results/band_power.csv. Fixed invocation options: --operation bands.",
      "method_ref": "reviewed.mne-eeg-tool.original-bands"
    },
    {
      "capability": "skill.mne-eeg-tool",
      "method_id": "reviewed-original-erp-mne-eeg-tool",
      "label": "原脚本 ERP 峰值、潜伏期与 AUC",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [],
      "execution_resolution": {},
      "role": "Average existing MNE epochs and extract each channel’s maximum-absolute ERP peak, peak latency and trapezoidal sum of absolute amplitudes. The original AUC calculation integrates over sample indices, without a time-spacing factor. Inputs: input: Epochs FIF (file). Registered outputs: results/erp_features.csv. Fixed invocation options: --operation erp.",
      "method_ref": "reviewed.mne-eeg-tool.original-erp"
    },
    {
      "capability": "skill.mne-eeg-tool",
      "method_id": "reviewed-original-alpha-ratio-mne-eeg-tool",
      "label": "原脚本 F3/F4 滤波后均值比值（非对数功率差）",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [],
      "execution_resolution": {},
      "role": "Filter continuous EEG at 8–13 Hz, split into 2-second epochs and compute (F3 mean - F4 mean) / (F3 mean + F4 mean), as implemented by the original function. Both F3 and F4 channels are required. This is a ratio of mean signals, not logarithmic alpha-power asymmetry. Inputs: input: 原始 EEG 文件 (file). Registered outputs: results/alpha_asymmetry.npy. Fixed invocation options: --operation alpha-ratio.",
      "method_ref": "reviewed.mne-eeg-tool.original-alpha-ratio"
    },
    {
      "capability": "skill.mne-eeg-tool",
      "method_id": "reviewed-original-features-mne-eeg-tool",
      "label": "原脚本 CSP、频带、Hjorth 与熵特征",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [],
      "execution_resolution": {},
      "role": "From existing labelled MNE epochs, call the original feature extractor for alpha-band multitaper power, four supervised CSP components, Hjorth mobility and sample entropy. Save the feature arrays in NPZ; the original CSP fit is not a cross-validated prediction test. Inputs: input: Epochs FIF (file). Registered outputs: results/features.npz. Fixed invocation options: --operation features.",
      "method_ref": "reviewed.mne-eeg-tool.original-features"
    },
    {
      "capability": "skill.mne-eeg-tool",
      "method_id": "reviewed-original-microstates-mne-eeg-tool",
      "label": "原脚本 mne_microstates 分析",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [],
      "execution_resolution": {},
      "role": "Fit the original mne_microstates Microstates model with four states to a continuous recording and save its FIF output. No alternative clustering implementation is substituted. Inputs: input: 原始 EEG 文件 (file). Registered outputs: results/microstates.fif. Fixed invocation options: --operation microstates.",
      "method_ref": "reviewed.mne-eeg-tool.original-microstates"
    }
  ],
