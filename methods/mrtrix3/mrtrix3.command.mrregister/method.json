  "execution": {
    "kind": "command",
    "contract": {
      "software": "mrtrix3",
      "command": "mrregister",
      "version": "3.0.8",
      "argv": [
        {
          "tokens": [
            {
              "input": "moving"
            },
            {
              "input": "fixed"
            }
          ],
          "when": {},
          "optional": false
        },
        {
          "tokens": [
            "-type",
            {
              "parameter": "type"
            }
          ],
          "when": {},
          "optional": false
        },
        {
          "tokens": [
            "-transformed",
            {
              "output": "registered"
            }
          ],
          "when": {},
          "optional": false
        },
        {
          "tokens": [
            "-rigid",
            {
              "output": "rigid"
            }
          ],
          "when": {
            "type": [
              "rigid",
              "rigid_affine",
              "rigid_nonlinear",
              "rigid_affine_nonlinear"
            ]
          },
          "optional": false
        },
        {
          "tokens": [
            "-affine",
            {
              "output": "affine"
            }
          ],
          "when": {
            "type": [
              "affine",
              "rigid_affine",
              "affine_nonlinear",
              "rigid_affine_nonlinear"
            ]
          },
          "optional": false
        },
        {
          "tokens": [
            "-nl_warp",
            {
              "output": "forward_warp"
            },
            {
              "output": "inverse_warp"
            }
          ],
          "when": {
            "type": [
              "nonlinear",
              "rigid_nonlinear",
              "affine_nonlinear",
              "rigid_affine_nonlinear"
            ]
          },
          "optional": false
        },
        {
          "tokens": [
            "-mask1",
            {
              "input": "mask1"
            }
          ],
          "when": {},
          "optional": true
        },
        {
          "tokens": [
            "-mask2",
            {
              "input": "mask2"
            }
          ],
          "when": {},
          "optional": true
        },
        {
          "tokens": [
            "-no_reorientation"
          ],
          "when": {
            "no_reorientation": [
              true
            ]
          },
          "optional": false
        },
        {
          "tokens": [
            "-rigid_niter",
            {
              "parameter": "rigid_niter"
            }
          ],
          "when": {},
          "optional": true
        },
        {
          "tokens": [
            "-affine_niter",
            {
              "parameter": "affine_niter"
            }
          ],
          "when": {},
          "optional": true
        },
        {
          "tokens": [
            "-nl_niter",
            {
              "parameter": "nl_niter"
            }
          ],
          "when": {},
          "optional": true
        },
        {
          "tokens": [
            "-nthreads",
            {
              "parameter": "nthreads"
            }
          ],
          "when": {},
          "optional": false
        }
      ],
      "patterns": {
        "rigid_niter": "\\d+(,\\d+)*",
        "affine_niter": "\\d+(,\\d+)*",
        "nl_niter": "\\d+(,\\d+)*"
      },
      "complete_groups": [],
      "omitted_options": {
