# Copy to runtime/server/science-paths.env; edit installed absolute paths.
# The file is sourced by server-env.sh. It contains no Agnes credentials.
export LOCALFLOW_MRTRIX_ROOT=/opt/software/mrtrix3-master
export LOCALFLOW_MRTRIX_LIBPNG=/lib/x86_64-linux-gnu/libpng16.so.16
export LOCALFLOW_FSL_ROOT=/opt/software/fsl
export LOCALFLOW_ANTS_ROOT=/opt/software/ants-2.6.5
export LOCALFLOW_FREESURFER_HOME=/opt/software/freesurfer-7.4.1/usr/local/freesurfer/7.4.1
export LOCALFLOW_FREESURFER_LICENSE=/opt/software/freesurfer-7.4.1/usr/local/freesurfer/7.4.1/license.txt
export LOCALFLOW_DIPY_PYTHON="$LOCALFLOW_SLURM_PYTHON"
# Optional, according to the selected Method:
# export LOCALFLOW_TORCH_PYTHON=/opt/neuroweave/envs/torch-cu128-py311/bin/python
# export LOCALFLOW_DCM2NIIX=/opt/software/fsl/bin/dcm2niix
# export LOCALFLOW_FREESURFER_BC=/usr/bin/bc
# export LOCALFLOW_FREESURFER_LIBGOMP=/lib/x86_64-linux-gnu/libgomp.so.1
# export LOCALFLOW_FREESURFER_LIBQUADMATH=/lib/x86_64-linux-gnu/libquadmath.so.0
# Data Python container capabilities are optional and independently configured.
# export NEUROWEAVE_DATA_PYTHON_IMAGE=sha256:REPLACE_WITH_EXISTING_IMAGE_ID
# export NEUROWEAVE_DATA_PYTHON_ENVIRONMENTS_FILE=/protected/data-python-environments.json
