    {
      "id": "stat_vox",
      "argument": "stat_vox",
      "label": "stat_vox",
      "description": "define the statistic for choosing the final voxel intensities for a given contrast type given the individual values from the tracks passing through each voxel. \nOptions are: sum, min, mean, max (default: sum)",
      "type": "string",
      "required": false,
      "default": null,
      "usage": "使用原始命令参数；未指定的可选参数不传给软件。",
      "software_default": "参见本机安装版本原始帮助。",
      "documentation_url": "https://mrtrix.readthedocs.io/en/3.0.8/reference/commands/tckmap.html",
