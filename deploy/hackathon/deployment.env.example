# Copy to runtime/server/deployment.env. Bash syntax; no model secrets.
# Replace the placeholder with the SAME full commit as the source/Worker.
NW_SERVER_WORKER_ROOT=/home/data/neuroweave/worker/releases/agh-agnes/REPLACE_WITH_FULL_COMMIT
NW_SERVER_OUTPUT_ROOT=/home/data/neuroweave/competition/agh-agnes
NW_SERVER_SCIENTIFIC_PYTHON=/opt/neuroweave/envs/scientific-py311/bin/python
NW_SERVER_DATA_ROOTS='共享数据::/home/data;服务器目录::/'
NW_SERVER_RUN_INPUT_ROOTS=/
NEUROWEAVE_RELEASE_REVISION=REPLACE_WITH_FULL_COMMIT
# All three services listen on loopback. Use SSH forwarding to access AGH.
NW_BRIDGE_PORT=8127
NW_SERVER_WEB_PORT=4187
NW_SERVER_WS_PORT=46173
# For non-default Web ports set the matching origin as well.
NW_SERVER_WEB_ORIGIN=http://127.0.0.1:4187
