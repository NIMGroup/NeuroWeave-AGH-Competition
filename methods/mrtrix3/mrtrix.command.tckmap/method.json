      "minimum": 0,
      "group": "计算资源",
      "level": "advanced"
    }
  ],
  "input_slots": [
    {
      "id": "tracks",
      "type": "generated_file",
      "label": "tracks",
      "description": "the input track file.",
      "required": true,
      "binding": "file"
    },
    {
      "id": "template",
      "type": "imaging_input",
      "label": "template",
      "description": "an image file to be used as a template for the output (the output image will have the same transform and field of view).",
      "required": false,
      "binding": "file"
    },
    {
      "id": "image",
      "type": "imaging_input",
      "label": "image",
      "description": "provide the scalar image map for generating images with 'scalar_map' / 'scalar_map_count' contrast, or the spherical harmonics image for 'fod_amp' contrast",
      "required": false,
      "binding": "file"
    },
    {
      "id": "vector_file",
      "type": "generated_file",
      "label": "vector_file",
      "description": "provide the vector data file for generating images with 'vector_file' contrast",
      "required": false,
      "binding": "file"
    },
    {
      "id": "tck_weights_in",
      "type": "generated_file",
      "label": "tck_weights_in",
      "description": "specify a text scalar file containing the streamline weights",
      "required": false,
      "binding": "file"
    }
  ],
  "output_slots": [
    {
      "id": "output",
      "type": "imaging_input",
      "label": "output",
      "description": "the output track-weighted image The output meaning depends on the input and selected operation. This generic image port does not certify anatomical labels, diffusion orientation, tissue fractions or spatial alignment.",
      "format": ".mif",
      "path_template": "output.mif"
    }
  ],
