# Copy to runtime/server/deployment.env for planning without compute infrastructure.
# Node, the API environment, official AGH and Agnes access are still required.
NW_SERVER_MODE=planning
NW_BRIDGE_PORT=8127
NW_SERVER_WEB_PORT=4187
NW_SERVER_WS_PORT=46173
NW_SERVER_WEB_ORIGIN=http://127.0.0.1:4187
# Dataset and output selection are optional when delivering a workflow draft.
# The default output root is runtime/server/outputs in this local installation.
