    {
      "id": "input",
      "type": "preprocessed_dwi",
      "label": "input",
      "description": "已生成的 MIF DWI；仅转换容器，不执行插值、平滑或其他预处理。",
      "required": true,
      "binding": "file",
      "formats": [
        ".mif"
      ]
    }
  ],
  "output_slots": [
    {
      "id": "output",
      "type": "preprocessed_dwi",
